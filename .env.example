# Copy this file to .env and fill only the providers you plan to run.
# Do not commit .env.

# Select one profile from configs/mvp.medmcqa.yaml:
# deepseek_v4_flash, deepseek_v4_pro, glm_5_2, kimi_k3, minimax_m3, qwen_3_7_max_preview, gpt_5_5, claude_opus_5_compat
CUPS_MODEL_PROFILE=deepseek_v4_pro

# Hugging Face is only needed for gated/private dataset downloads.
HF_TOKEN=

# DeepSeek OpenAI-compatible API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_V4_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_V4_PRO_MODEL=deepseek-v4-pro

# GLM / Zhipu OpenAI-compatible API
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-5.2

# Kimi / Moonshot OpenAI-compatible API
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3

# MiniMax OpenAI-compatible API
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_M3_MODEL=MiniMax-M3

# Qwen / DashScope OpenAI-compatible API
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-max-preview

# OpenAI API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5

# Claude is not supported through Anthropic-native API yet.
# Use this only if you have an OpenAI-compatible gateway for Claude.
CLAUDE_OPENAI_COMPAT_API_KEY=
CLAUDE_OPENAI_COMPAT_BASE_URL=
CLAUDE_OPENAI_COMPAT_MODEL=claude-opus-5
